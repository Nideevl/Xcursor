/* ============================================================================
   UNIVERSAL STYLES
   ============================================================================ */
QMainWindow #content {
    background: transparent;
}

QMainWindow #messageContainer {
    background: transparent;
}

QMainWindow #userMessageWrapper {
    margin: 2px 0px;
}

QMainWindow #aiMessageWrapper {
    margin: 2px 0px;
}

QMainWindow #scrollArea QScrollBar::add-line:vertical,
QMainWindow #scrollArea QScrollBar::sub-line:vertical {
    border: none;
    background: none;
}

QSizeGrip {
    width: 20px;
    height: 20px;
    background: transparent;
}
