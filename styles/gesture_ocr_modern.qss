/* ============================================================================
   XCURSOR - FIXED VERSION: Slider groove height WILL change now
   The KEY is: padding on SLIDER, not on GROOVE
   ============================================================================ */

QMainWindow #stopButton,
QMainWindow #sendButton {
    border: none;
    background: transparent;
}

/* ============================================================================
   UNIVERSAL BRIGHTNESS CONTAINER
   ============================================================================ */
QMainWindow #brightnessContainer {
    background: transparent;
}

QMainWindow #opacityPercentage {
    font-size: 11px;
    font-weight: 500;
    min-width: 25px;
}

/* ============================================================================
   DARK THEME (DEFAULT)
   ============================================================================ */
QMainWindow[theme="dark"] #glassWidget {
    background: rgba(0, 0, 0, 0.97);
    border-radius: 12px;
    border: 1px solid rgba(48, 54, 61, 0.90);
}

QMainWindow[theme="dark"] #header {
    background: transparent;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border: 1px solid rgba(48, 54, 61, 0.90);
    border-bottom: none;
}

QMainWindow[theme="dark"] #titleLabel {
    color: #E6EDF3;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
}

QMainWindow[theme="dark"] #separator {
    background: transparent;
    border: none;
}

/* ============================================================================
   DARK THEME - CIRCULAR Theme Buttons (50% = Perfect Circles)
   ============================================================================ */
QMainWindow[theme="dark"] #themeBtn-dark {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffffff, stop:1 #7a8290);
    border: 1px solid #f0f6fc;
    border-radius: 4px;
    color: transparent;
    font-size: 0px;
    font-weight: 700;
    padding: 0px;
    margin: 0px 2px;
    min-width: 13px;
    max-width: 13px;
    min-height: 13px;
    max-height: 13px;
}

QMainWindow[theme="dark"] #themeBtn-dark:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #ffffff, stop:1 #8a92a0);
    border: 1px solid #ffffff;
    margin: 0px 1px;
}

QMainWindow[theme="dark"] #themeBtn-green {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #69F0AE, stop:1 #00A030);
    border: 1px solid rgba(76, 175, 80, 0.30);
    border-radius: 4px;
    color: transparent;
    font-size: 0px;
    font-weight: 700;
    padding: 0px;
    margin: 0px 2px;
    min-width: 13px;
    max-width: 13px;
    min-height: 13px;
    max-height: 13px;
}

QMainWindow[theme="dark"] #themeBtn-green:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #76FF8F, stop:1 #00B83A);
    border: 1px solid rgba(76, 175, 80, 0.80);
    margin: 0px 1px;
}

QMainWindow[theme="dark"] #themeBtn-blue {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #64B5FF, stop:1 #1040D0);
    border: 1px solid rgba(21, 101, 192, 0.30);
    border-radius: 4px;
    color: transparent;
    font-size: 0px;
    font-weight: 700;
    padding: 0px;
    margin: 0px 2px;
    min-width: 13px;
    max-width: 13px;
    min-height: 13px;
    max-height: 13px;
}

QMainWindow[theme="dark"] #themeBtn-blue:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
        stop:0 #82B1FF, stop:1 #1656E0);
    border: 1px solid rgba(21, 101, 192, 0.80);
    margin: 0px 1px;
}

/* ✅ DARK THEME - SLIDER: Padding on WIDGET, not groove */
QMainWindow[theme="dark"] #opacitySlider {
    background: transparent;
    border: none;
    padding: 4px 0px;
}

QMainWindow[theme="dark"] #opacitySlider::groove:horizontal {
    background: rgba(255, 255, 255, 0.1);
    border: none;
    height: 3px;
    margin: 0px;
    border-radius: 1px;
}

QMainWindow[theme="dark"] #opacitySlider::handle:horizontal {
    background: #ffffff;
    border: 1px solid #ffffff;
    width: 9px;
    height: 8px;
    margin: -4px 0px;
    border-radius: 5px;
}

QMainWindow[theme="dark"] #opacitySlider::handle:horizontal:hover {
    background: #f0f6fc;
    border: 1px solid #f0f6fc;
}

QMainWindow[theme="dark"] #opacitySlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #eaedf1, stop:1 #b3b5b6);
    border-radius: 1px;
}

QMainWindow[theme="dark"] #minimizeButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    color: #8b949e;
    font-size: 16px;
    font-weight: 600;
    padding: 2px 6px;
}

QMainWindow[theme="dark"] #minimizeButton:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #E6EDF3;
}

QMainWindow[theme="dark"] #scrollArea {
    background: transparent;
    border: none;
}

QMainWindow[theme="dark"] #scrollArea QScrollBar:vertical {
    background: rgba(255, 255, 255, 0.02);
    border: none;
    width: 6px;
    border-radius: 3px;
    margin: 2px;
}

QMainWindow[theme="dark"] #scrollArea QScrollBar::handle:vertical {
    background: rgba(110, 118, 129, 0.30);
    border-radius: 3px;
    min-height: 20px;
}

QMainWindow[theme="dark"] #scrollArea QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.2);
}

QMainWindow[theme="dark"] #userBubble {
    background: rgb(41, 41, 41);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border: 1px solid rgba(255, 255, 255, 0.12);
}

QMainWindow[theme="dark"] #userMessageContent {
    color: #ffffff;
    font-family: "Aptos";
    font-size: 14px;
    font-weight: normal;
    padding: 2px;
    background-color: transparent;
}

QMainWindow[theme="dark"] #showMoreButton {
    color: #58A6FF;
    background: transparent;
    border: none;
    font-size: 11px;
    font-weight: 500;
    padding: 2px 0px;
    text-align: left;
}

QMainWindow[theme="dark"] #showMoreButton:hover {
    text-decoration: underline;
}

QMainWindow[theme="dark"] #aiStarIcon {
    font-size: 14px;
    background: transparent;
}

QMainWindow[theme="dark"] #aiNameLabel {
    color: #E6EDF3;
    font-size: 13px;
    font-weight: 600;
    background: transparent;
}

QMainWindow[theme="dark"] #aiMessageContent {
    color: #E6EDF3;
    font-size: 14px;
    padding: 0px;
    background-color: transparent;
    line-height: 1.6;
}

QMainWindow[theme="dark"] #inputContainer {
    background: rgba(48, 54, 61, 0.50);
    border-radius: 20px;
    border: 1px solid rgba(48, 54, 61, 0.90);
}

QMainWindow[theme="dark"] #inputField {
    background: transparent;
    border: none;
    color: #E6EDF3;
    font-size: 14px;
    padding: 10px 16px;
    selection-background-color: rgba(88, 166, 255, 0.30);
    margin: 0px;
}

QMainWindow[theme="dark"] #inputField::placeholder {
    color: #484f58;
}

QMainWindow[theme="dark"] #stopButton {
    font-weight: 600;
}

QMainWindow[theme="dark"] #sendButton {
    color: #58A6FF;
    font-weight: 600;
}

